[Unit]
Description=Sauce Steward - persistent bounded QA worker (no AI or code edits)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=devmcp
Group=devmcp
WorkingDirectory=/var/lib/sauce-steward
Environment=HOME=/var/lib/sauce-steward
Environment=SAUCE_STEWARD_STATE=/var/lib/sauce-steward
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /usr/local/lib/sauce-steward/sauce_steward.py daemon
Restart=always
RestartSec=15
TimeoutStopSec=15
UMask=0077
StateDirectory=sauce-steward
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/sauce-steward
MemoryMax=1200M
CPUQuota=150%
TasksMax=80

[Install]
WantedBy=multi-user.target
