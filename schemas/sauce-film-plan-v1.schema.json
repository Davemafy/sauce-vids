{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Davemafy/sauce-vids/blob/main/schemas/sauce-film-plan-v1.schema.json",
  "title": "Sauce source-true film plan v1",
  "description": "Declarative site-independent camera, recorded pointer and licensed media binding over a hash-pinned browser capture. Real source events are validated separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceSha256",
    "manifestSha256",
    "durationSeconds",
    "presentation",
    "cursor"
  ],
  "properties": {
    "schema": {
      "const": "sauce-film-plan-v1"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0.5
    },
    "presentation": {
      "enum": [
        "fullscreen",
        "window"
      ]
    },
    "cursor": {
      "enum": [
        "recorded",
        "none"
      ]
    },
    "cursorMotion": {
      "enum": ["reference-v1", "editorial-click-v1"],
      "description": "Recorded sample interpolation or explicitly editorial motion between verified real click anchors."
    },
    "audio": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "clean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "file"
          ],
          "properties": {
            "mode": {
              "const": "file"
            },
            "file": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "eventFoley"
            },
            "eventIndex": {
              "type": "integer",
              "minimum": 0
            },
            "clickGain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "motionGain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "masterGain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "eventIndices": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "oneOf": [
            {
              "required": [
                "eventIndex"
              ]
            },
            {
              "required": [
                "eventIndices"
              ]
            }
          ]
        }
      ]
    },
    "camera": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "anchor",
          "zoom"
        ],
        "properties": {
          "at": {
            "type": "number",
            "minimum": 0
          },
          "startAt": {
            "type": "number",
            "minimum": 0
          },
          "anchor": {
            "type": "string",
            "pattern": "^(wide|event:[0-9]+:(target|result|group|component))$"
          },
          "zoom": {
            "type": "number",
            "minimum": 1,
            "maximum": 2.5
          },
          "easing": {
            "enum": [
              "quintic",
              "linear"
            ]
          }
        }
      }
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "backdrop": [
          "backdropSha256"
        ],
        "backdropSha256": [
          "backdrop"
        ]
      },
      "properties": {
        "scale": {
          "type": "number",
          "minimum": 0.65,
          "maximum": 1
        },
        "backdrop": {
          "type": "string",
          "minLength": 1
        },
        "backdropSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "glassLoupe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor_style": {
          "enum": [
            "rounded",
            "outlined",
            "clean"
          ]
        },
        "entry_delay": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "entry_duration": {
          "type": "number",
          "minimum": 0.08,
          "maximum": 1.5
        },
        "expand_duration": {
          "type": "number",
          "minimum": 0.08,
          "maximum": 1.5
        },
        "expand_delay": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "exit_delay": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "exit_duration": {
          "type": "number",
          "minimum": 0.08,
          "maximum": 1.5
        },
        "small_radius": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.85
        },
        "expanded_radius": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.85
        },
        "expanded_center_x": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.85
        },
        "payoff_y": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.85
        },
        "expanded_center_y": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.85
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "startAt",
        "background",
        "layers"
      ],
      "properties": {
        "mode": {
          "const": "isolated-ui"
        },
        "startAt": {
          "type": "number",
          "minimum": 0
        },
        "background": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "anchor",
              "sourceAt",
              "startAt",
              "endAt",
              "position",
              "widthFraction"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,40}$"
              },
              "anchor": {
                "type": "string",
                "pattern": "^event:[0-9]+:(target|result|component)$"
              },
              "sourceAt": {
                "type": "number",
                "minimum": 0
              },
              "startAt": {
                "type": "number",
                "minimum": 0
              },
              "endAt": {
                "type": "number",
                "minimum": 0
              },
              "position": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "enterFrom": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "enterSeconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 1.5
              },
              "widthFraction": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 0.85
              },
              "paddingPx": {
                "type": "integer",
                "minimum": 0,
                "maximum": 180
              },
              "radiusPx": {
                "type": "integer",
                "minimum": 0,
                "maximum": 28
              },
              "zIndex": {
                "type": "integer",
                "minimum": -20,
                "maximum": 20
              },
              "holdScaleEnd": {
                "type": "number",
                "minimum": 0.9,
                "maximum": 1.1,
                "description": "Optional source-true isolated UI crop scale at the end of its visible hold. Linear interpolation from initial width; original pixels unchanged."
              }
            }
          }
        }
      }
    },
    "studioStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera",
        "lighting"
      ],
      "properties": {
        "camera": {
          "type": "array",
          "minItems": 2,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "scale"
            ],
            "properties": {
              "at": {
                "type": "number",
                "minimum": 0
              },
              "startAt": {
                "type": "number",
                "minimum": 0
              },
              "scale": {
                "type": "number",
                "minimum": 0.55,
                "maximum": 1.55
              },
              "yaw": {
                "type": "number",
                "minimum": -16,
                "maximum": 16
              },
              "pitch": {
                "type": "number",
                "minimum": -12,
                "maximum": 12
              },
              "focus": {
                "type": "string"
              },
              "center": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 0.9
                }
              },
              "cut": {
                "type": "boolean",
                "description": "Explicit native-frame editorial camera cut. When true, startAt=at. Never changes genuine source pixels."
              },
              "viewScale": {
                "type": "number",
                "minimum": 1,
                "maximum": 1.8,
                "description": "Opt-in physical camera dolly of source-true floating window, not an invented browser zoom. Requires motion.profile=reference-spring and motion.immersive=true."
              }
            }
          }
        },
        "lighting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eventIndex"
          ],
          "properties": {
            "eventIndex": {
              "type": "integer",
              "minimum": 0
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1.2
            },
            "transitionSeconds": {
              "type": "number",
              "minimum": 0.08,
              "maximum": 1.5
            },
            "trigger": {
              "enum": [
                "verified",
                "appearance"
              ]
            }
          }
        },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            },
            "grain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "depthPx": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "reflection": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.18
        },
        "payoff": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "region": {
              "type": "string",
              "pattern": "^event:[0-9]+:(result|component)$"
            },
            "minVisible": {
              "type": "number",
              "minimum": 0.6,
              "maximum": 1
            },
            "mode": {
              "enum": [
                "overview",
                "detail"
              ]
            },
            "minContextVisible": {
              "type": "number",
              "minimum": 0.65,
              "maximum": 1
            }
          }
        },
        "stagePreset": {
          "enum": [
            "classic",
            "cloud_shadow_v1",
            "cloud_window_sky_v1",
            "cloud_window_fullglass_v1",
            "cloud_window_volume_v1",
            "cloud_window_clearface_v1",
            "cloud_luminous_display_v1"
          ]
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile": {
              "enum": [
                "classic",
                "cinematic",
                "reference-spring"
              ]
            },
            "shutter": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.75
            },
            "immersive": {
              "type": "boolean"
            },
            "follow": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "eventIndices"
              ],
              "properties": {
                "mode": {
                  "const": "source-cursor-spring"
                },
                "eventIndices": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "responseSeconds": {
                  "type": "number",
                  "minimum": 0.18,
                  "maximum": 0.95
                },
                "strength": {
                  "type": "number",
                  "minimum": 0.04,
                  "maximum": 0.45
                },
                "deadzone": {
                  "type": "number",
                  "minimum": 0.03,
                  "maximum": 0.23
                },
                "maxOffset": {
                  "type": "number",
                  "minimum": 0.008,
                  "maximum": 0.075
                },
                "beforeSeconds": {
                  "type": "number",
                  "minimum": 0.25,
                  "maximum": 1.15
                },
                "afterSeconds": {
                  "type": "number",
                  "minimum": 0.25,
                  "maximum": 1.2
                }
              }
            }
          }
        }
      }
    },
    "domPlane": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional source-verified independently projected real DOM plane, requires an authentic same-clock DOM-hidden clean plate in capture manifest.",
      "required": [
        "id",
        "eventIndex",
        "startAt",
        "peakAt",
        "endAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 70
        },
        "eventIndex": {
          "type": "integer",
          "minimum": 0
        },
        "startAt": {
          "type": "number",
          "minimum": 0
        },
        "peakAt": {
          "type": "number",
          "minimum": 0
        },
        "endAt": {
          "type": "number",
          "minimum": 0
        },
        "liftPx": {
          "type": "number",
          "minimum": 0,
          "maximum": 160
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.55
        },
        "shadowStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.6
        },
        "driftXPx": {
          "type": "number",
          "minimum": -120,
          "maximum": 120
        },
        "heroCenter": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0.14,
            "maximum": 0.86
          }
        }
      }
    },
    "domPlanes": {
      "description": "At most three source-true real DOM planes, all selected from one synchronized collectively-hidden Chromium plate.",
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "description": "Optional source-verified independently projected real DOM plane, requires an authentic same-clock DOM-hidden clean plate in capture manifest.",
        "required": [
          "id",
          "eventIndex",
          "startAt",
          "peakAt",
          "endAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 70
          },
          "eventIndex": {
            "type": "integer",
            "minimum": 0
          },
          "startAt": {
            "type": "number",
            "minimum": 0
          },
          "peakAt": {
            "type": "number",
            "minimum": 0
          },
          "endAt": {
            "type": "number",
            "minimum": 0
          },
          "liftPx": {
            "type": "number",
            "minimum": 0,
            "maximum": 160
          },
          "scale": {
            "type": "number",
            "minimum": 1,
            "maximum": 1.55
          },
          "shadowStrength": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.6
          },
          "driftXPx": {
            "type": "number",
            "minimum": -120,
            "maximum": 120
          },
          "heroCenter": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0.14,
              "maximum": 0.86
            }
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "camera"
      ]
    },
    {
      "required": [
        "studioStage"
      ]
    }
  ]
}
