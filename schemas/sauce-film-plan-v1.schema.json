{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Davemafy/sauce-vids/blob/main/schemas/sauce-film-plan-v1.schema.json",
  "title": "Sauce source-true film plan v1",
  "description": "Declarative site-independent camera, recorded pointer and licensed media binding over a hash-pinned browser capture. Real source events are validated separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceSha256",
    "manifestSha256",
    "durationSeconds",
    "presentation",
    "cursor",
    "camera"
  ],
  "properties": {
    "schema": {
      "const": "sauce-film-plan-v1"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0.5
    },
    "presentation": {
      "enum": [
        "fullscreen",
        "window"
      ]
    },
    "cursor": {
      "enum": [
        "recorded",
        "none"
      ]
    },
    "audio": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "clean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "file"
          ],
          "properties": {
            "mode": {
              "const": "file"
            },
            "file": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "camera": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "anchor",
          "zoom"
        ],
        "properties": {
          "at": {
            "type": "number",
            "minimum": 0
          },
          "startAt": {
            "type": "number",
            "minimum": 0
          },
          "anchor": {
            "type": "string",
            "pattern": "^(wide|event:[0-9]+:(target|result|group|component))$"
          },
          "zoom": {
            "type": "number",
            "minimum": 1,
            "maximum": 2.5
          },
          "easing": {
            "enum": [
              "quintic",
              "linear"
            ]
          }
        }
      }
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "backdrop": [
          "backdropSha256"
        ],
        "backdropSha256": [
          "backdrop"
        ]
      },
      "properties": {
        "scale": {
          "type": "number",
          "minimum": 0.65,
          "maximum": 1
        },
        "backdrop": {
          "type": "string",
          "minLength": 1
        },
        "backdropSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "glassLoupe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor_style": {
          "enum": [
            "rounded",
            "outlined",
            "clean"
          ]
        },
        "entry_delay": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "entry_duration": {
          "type": "number",
          "minimum": 0.08,
          "maximum": 1.5
        },
        "expand_duration": {
          "type": "number",
          "minimum": 0.08,
          "maximum": 1.5
        },
        "expand_delay": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "exit_delay": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "exit_duration": {
          "type": "number",
          "minimum": 0.08,
          "maximum": 1.5
        },
        "small_radius": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.85
        },
        "expanded_radius": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.85
        },
        "expanded_center_x": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.85
        },
        "payoff_y": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.85
        },
        "expanded_center_y": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.85
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "startAt",
        "background",
        "layers"
      ],
      "properties": {
        "mode": {
          "const": "isolated-ui"
        },
        "startAt": {
          "type": "number",
          "minimum": 0
        },
        "background": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "anchor",
              "sourceAt",
              "startAt",
              "endAt",
              "position",
              "widthFraction"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,40}$"
              },
              "anchor": {
                "type": "string",
                "pattern": "^event:[0-9]+:(target|result|component)$"
              },
              "sourceAt": {
                "type": "number",
                "minimum": 0
              },
              "startAt": {
                "type": "number",
                "minimum": 0
              },
              "endAt": {
                "type": "number",
                "minimum": 0
              },
              "position": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "enterFrom": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "enterSeconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 1.5
              },
              "widthFraction": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 0.85
              },
              "paddingPx": {
                "type": "integer",
                "minimum": 0,
                "maximum": 180
              },
              "radiusPx": {
                "type": "integer",
                "minimum": 0,
                "maximum": 28
              },
              "zIndex": {
                "type": "integer",
                "minimum": -20,
                "maximum": 20
              },
              "holdScaleEnd": {
                "type": "number",
                "minimum": 0.9,
                "maximum": 1.1,
                "description": "Optional source-true isolated UI crop scale at the end of its visible hold. Linear interpolation from initial width; original pixels unchanged."
              }
            }
          }
        }
      }
    }
  }
}
